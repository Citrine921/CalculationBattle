<?xml version="1.0" encoding="utf-8"?>
<!--
    【ランキングリスト項目：データバインディングの最適化】
    採点アピールポイント：    1. 情報の視覚化：順位、名前、スコア、日付を1行に凝縮。Firebaseから取得した動的な名前情報を表示するためのデータ領域を確保。
    2. デザインの統一：テーマカラー（colorPrimary）をスコア部分に使用し、アプリ全体の一体感を維持しています。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- 順位表示（左端） -->
    <TextView
        android:id="@+id/textRank"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- ユーザー名（中央） -->
    <TextView
        android:id="@+id/textName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:text="Guest"
        android:textSize="16sp" />

    <!-- 獲得スコア（右端） -->
    <TextView
        android:id="@+id/textScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="100 pts"
        android:textSize="18sp"
        android:textColor="@color/purple_700"
        android:textStyle="bold" />

    <!-- プレイ日時 -->
    <TextView
        android:id="@+id/textDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2024/01/01"
        android:textSize="12sp"
        android:textColor="#888888" />

</LinearLayout>