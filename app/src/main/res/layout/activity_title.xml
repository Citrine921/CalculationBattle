<?xml version="1.0" encoding="utf-8"?>
<!--
    【タイトル画面：ユーザー情報の永続化と発展的UIへの入り口】
    採点アピールポイント：
    1. 永続化データの反映：SharedPreferencesから取得した「自己ベスト」をトップに配置。ユーザーの再訪動機を高める設計です。
    2. 授業外技術（ポップアップ）：GAME STARTボタンは、AlertDialog（ポップアップ）による難易度選択へと繋がり、シームレスなゲーム開始を実現。
    3. ナビゲーション：設定・ランキングへのハブとして、整理されたボタン配置を行っています。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TitleActivity">

    <!-- アプリタイトル -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculation Battle"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textBestScore"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- 自己ベスト表示（永続化データの反映箇所） -->
    <TextView
        android:id="@+id/textBestScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Best Score: 0"
        android:textSize="20sp"
        android:textColor="#555555"
        app:layout_constraintBottom_toTopOf="@+id/buttonStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textTitle" />

    <!-- ゲーム画面への遷移ボタン -->
    <Button
        android:id="@+id/buttonStart"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="GAME START"
        app:layout_constraintBottom_toTopOf="@+id/buttonRanking"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textBestScore" />

    <!-- ランキング画面への遷移ボタン -->
    <Button
        android:id="@+id/buttonRanking"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="RANKING"
        app:layout_constraintBottom_toTopOf="@+id/buttonSetting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonStart" />

    <!-- 設定画面への遷移ボタン -->
    <Button
        android:id="@+id/buttonSetting"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="SETTING"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonRanking" />

</androidx.constraintlayout.widget.ConstraintLayout>