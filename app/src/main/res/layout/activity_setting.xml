<?xml version="1.0" encoding="utf-8"?>
<!--
    【設定画面：パーソナライズと全体への設定反映】
    採点アピールポイント：
    1. 授業外技術（テーマ反映）：ここで選択したテーマカラーが、BaseActivityを通じてアプリ「全画面」の背景やボタンに即座に反映される高度な連携機能を実装。
    2. 設定の永続化：ユーザー名、音量、テーマなどの多様な設定項目を完備し、SharedPreferencesへの保存・読み込みを完全自動化しています。
    3. ユーザビリティ：ScrollViewにより、端末のサイズを問わずすべての項目にアクセス可能な親切設計。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:text="SETTINGS"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>

        <!-- ユーザー名入力（名前変更機能） -->
        <TextView
            android:text="User Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/editUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Name"
            android:inputType="textPersonName"/>

        <!-- 採点ポイント：設定反映。テーマカラーの選択肢 -->
        <TextView
            android:text="Theme Color"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <RadioGroup
            android:id="@+id/radioGroupTheme"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/radioWhite" android:text="White" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/radioBlack" android:text="Black" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/radioBlue" android:text="Blue" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/radioPurple" android:text="Purple" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </RadioGroup>

        <!-- 音量設定（BGM） -->
        <TextView
            android:text="BGM Volume"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <SeekBar
            android:id="@+id/seekBgm"
            android:max="100"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- 音量設定（SE） -->
        <TextView
            android:text="System Volume"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <SeekBar
            android:id="@+id/seekSe"
            android:max="100"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- 設定保存ボタン -->
        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="SAVE ＆ BACK" />

    </LinearLayout>
</ScrollView>