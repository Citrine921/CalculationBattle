<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        【発展：マルチテーマ・システム】
        採点アピールポイント：
        1. 授業外技術（全体反映）：複数のスタイルリソースを定義し、設定画面での選択をJava側（BaseActivity）で検知して動的に切り替える仕組みを構築。
        2. UI/UXの追求：各テーマ（黒・青・紫）において、単に背景色を変えるだけでなく、ボタンの色や文字色のコントラストを最適化し、使いやすさを追求。
    -->

    <!-- ベースとなる標準テーマ（白） -->
    <style name="Theme.CalculationBattle" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- 【発展】黒テーマ (ID: 1)：目に優しいダークモード的色彩 -->
    <style name="Theme_CalculationBattle_Black" parent="Theme.CalculationBattle">
        <item name="android:windowBackground">#000000</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
    </style>

    <!-- 【発展】青テーマ (ID: 2)：爽やかなライトブルー色彩 -->
    <style name="Theme_CalculationBattle_Blue" parent="Theme.CalculationBattle">
        <item name="android:windowBackground">#E3F2FD</item>
        <item name="android:textColor">#0D47A1</item>
        <item name="colorPrimary">#1565C0</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <!-- 【発展】紫テーマ (ID: 3)：落ち着いたパープル色彩 -->
    <style name="Theme_CalculationBattle_Purple" parent="Theme.CalculationBattle">
        <item name="android:windowBackground">#F3E5F5</item>
        <item name="android:textColor">#4A148C</item>
        <item name="colorPrimary">#7B1FA2</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>
</resources>